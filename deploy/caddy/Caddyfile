# For a new public app, add its name to `.env.example` and the caddy service's environment, add a block here, then re-run `bootstrap.sh`.

{$KOMODO_DOMAIN} {
	# Periphery connects to Core inside the compose network. No remote agent should.
	respond /ws/periphery 404
	reverse_proxy core:9120
}

{$EXAMINER_DASHBOARD_DOMAIN} {
	reverse_proxy examiner-dashboard:13003
}

{$AUTH_API_DOMAIN} {
	reverse_proxy auth-api:13003
}
