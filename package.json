{
  "name": "exam-platform",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "apps/web-app",
      "apps/examiner-dashboard",
      "apps/desktop-app"
    ],
    "catalog": {
      "@tanstack/react-query": "5.104.1",
      "@tanstack/react-query-devtools": "5.104.1",
      "@types/bun": "1.4.2",
      "@types/react": "19.3.0",
      "@types/react-dom": "19.3.0",
      "oxfmt": "0.73.0",
      "oxlint": "1.90.0",
      "oxlint-config-presets": "0.1.21",
      "oxlint-tsgolint": "7.0.2005",
      "react": "19.3.0",
      "react-dom": "19.3.0"
    },
    "catalogs": {
      "astro": {
        "@astrojs/check": "0.9.10",
        "@astrojs/react": "7.0.0",
        "@chakra-ui/react": "3.37.0",
        "@emotion/react": "11.14.0",
        "astro": "7.3.5",
        "next-themes": "0.4.6",
        "react-icons": "5.7.0",
        "typescript": "6.0.3"
      }
    }
  },
  "scripts": {
    "dev": "bun --filter web-app --filter examiner-dashboard-client dev",
    "dev:desktop": "bun --filter desktop-app tauri:dev",
    "build": "bun --filter '*' build",
    "check": "bun --filter '*' check",
    "lint": "bun --filter '*' lint",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "9.1.7",
    "lint-staged": "17.6.0"
  }
}
