#!/bin/sh
# Refreshes eDb's offline query data (databases/examiner/.sqlx/), as the sqlx FAQ recommends.
# Enable once per clone: `git config core.hooksPath .githooks`.
#
# Never blocks the commit: without a running eDb, `cargo sqlx prepare` fails, and CI's offline
# clippy catches a stale .sqlx/ instead.

# Skips the recompile when no eDb file is staged.
git diff --cached --quiet -- databases/examiner && exit 0

cd databases/examiner || exit 0
# sqlx-cli reads EDB_MIGRATOR_URL from this directory's .env (see sqlx.toml).
if cargo sqlx prepare >/dev/null 2>&1; then
  git add .sqlx >/dev/null 2>&1
else
  echo "pre-commit: cargo sqlx prepare failed; .sqlx/ may be stale" >&2
fi
exit 0
