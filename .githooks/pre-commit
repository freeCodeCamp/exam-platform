#!/bin/sh
# Refreshes each database's offline query data (databases/*/.sqlx/), as the sqlx FAQ recommends.
# Enable once per clone: `git config core.hooksPath .githooks`.
#
# Never blocks the commit: without a running database, `cargo sqlx prepare` fails, and CI's
# offline clippy catches a stale .sqlx/ instead.

root=$(git rev-parse --show-toplevel) || exit 0

for db in examiner moderation; do
  # Skips the recompile when none of this database's files are staged.
  git diff --cached --quiet -- "databases/$db" && continue

  # sqlx-cli reads the database URL from the directory's .env (see its sqlx.toml).
  if (cd "$root/databases/$db" && cargo sqlx prepare >/dev/null 2>&1); then
    git add "databases/$db/.sqlx" >/dev/null 2>&1
  else
    echo "pre-commit: cargo sqlx prepare failed in databases/$db; .sqlx/ may be stale" >&2
  fi
done
exit 0
