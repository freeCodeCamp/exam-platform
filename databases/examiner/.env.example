# Host port on 127.0.0.1. The container always listens on 5432.
EDB_PORT=15432
# Superuser `postgres`: bootstrap and tests only.
EDB_PASSWORD=
EDB_MIGRATOR_PASSWORD=
EDB_EDD_PASSWORD=
EDB_AAPI_PASSWORD=
PLATFORM_NETWORK=platform
# `DATABASE_URL` for tests: #[sqlx::test] creates a database per test.
EDB_ADMIN_URL=postgres://postgres:<EDB_PASSWORD>@127.0.0.1:15432/examiner
# edb-migrate, the sqlx macros, `cargo sqlx migrate` and `cargo sqlx prepare`.
EDB_MIGRATOR_URL=postgres://edb_migrator:<EDB_MIGRATOR_PASSWORD>@127.0.0.1:15432/examiner
