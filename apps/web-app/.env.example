# Release image to run instead of building:
# registry.digitalocean.com/<registry>/web-app@sha256:<digest>
# Empty: `docker compose up --build` builds from source. Komodo sets it on every deploy.
IMAGE=
# aAPI origin the browser calls. Served as /config.js at runtime: by Caddy in the image, by
# astro.config.ts in `astro dev`. Required by compose.yaml.
AUTH_API_URL=http://127.0.0.1:13001
# Host port on 127.0.0.1 for the container. The container always listens on 13003.
WAPP_PORT=13003
PLATFORM_NETWORK=platform
