# Serves the static build. Plain HTTP: TLS terminates in front of the container.
{
	admin off
	auto_https off
	persist_config off
}

:13003 {
	handle /healthz {
		header Cache-Control no-store
		respond "ok"
	}

	# Runtime config from the container env: one image serves every environment. No braces in
	# the body: Caddy reads them as placeholders.
	handle /config.js {
		header Content-Type "text/javascript; charset=utf-8"
		header Cache-Control no-store
		respond `globalThis.AUTH_API_URL = "{$AUTH_API_URL}";`
	}

	handle {
		root * /srv
		encode zstd gzip

		@exam path_regexp ^/exams/[^/]+/?$
		rewrite @exam /exams/_/index.html
		@profile path_regexp ^/users/[^/]+/profile/?$
		rewrite @profile /users/_/profile/index.html
		@certifications path_regexp ^/users/[^/]+/certifications/?$
		rewrite @certifications /users/_/certifications/index.html
		@certification path_regexp ^/users/[^/]+/certifications/[^/]+/?$
		rewrite @certification /users/_/certifications/_/index.html
		@attempt path_regexp ^/attempts/[^/]+/?$
		rewrite @attempt /attempts/_/index.html

		# Content-hashed by Astro: safe to cache forever.
		header /_astro/* Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle_errors 404 {
		root * /srv
		rewrite * /404.html
		file_server
	}
}
