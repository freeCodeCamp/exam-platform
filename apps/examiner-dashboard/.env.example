# Host port on 127.0.0.1. The container always listens on 13002.
EDD_PORT=13002
# development: logs to stdout, Sentry optional. staging/production: Sentry required, stdio
# carries errors only.
ENVIRONMENT=development
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.2
# Filters what reaches stdout (development) and Sentry (all environments).
RUST_LOG=info
PLATFORM_NETWORK=platform

# Google OAuth web client credentials. Register GOOGLE_REDIRECT_URL in Google Cloud.
GOOGLE_OAUTH_ID=
GOOGLE_OAUTH_SECRET=
# Production: use public HTTPS origin with /auth/google/callback.
GOOGLE_REDIRECT_URL=http://127.0.0.1:13002/auth/google/callback
# Private-cookie key: generate with `openssl rand -hex 64`. Keep secret and stable.
COOKIE_KEY=

# eDb (databases/examiner). Migrations run on startup. In compose, the host is `examiner-db`.
# Hosted Postgres: append `?sslmode=verify-full`.
EDB_DATABASE_URL=postgres://edd:<EDB_PASSWORD>@127.0.0.1:15432/examiner
