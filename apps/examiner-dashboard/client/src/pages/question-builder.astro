---
import { getEntry } from "astro:content";

import {QuestionBuilder} from "@/views/question-builder"

const aQuestion = await getEntry("questions", "one");
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Question builder</title>
  </head>
  <body>

  <QuestionBuilder question={aQuestion!.data} client:load/>
  </body>
</html>
