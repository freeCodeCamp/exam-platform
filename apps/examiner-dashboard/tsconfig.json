{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "astro.config.ts", "vitest-setup.ts", "client/**/*"],
  "exclude": ["dist"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "noUncheckedIndexedAccess": true,
    "types": ["bun"],
    "paths": {
      "@/*": ["./client/src/*"]
    }
  }
}
