# Host port on 127.0.0.1. The container always listens on 13001.
AAPI_PORT=13001
# development: logs to stdout, Sentry optional. staging/production: Sentry required, stdio
# carries errors only.
ENVIRONMENT=development
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.2
# Filters what reaches stdout (development) and Sentry (all environments).
RUST_LOG=info
PLATFORM_NETWORK=platform

# mDb (databases/moderation), as owner `aapi`. Migrations run on startup. In compose, the host is
# `moderation-db`. Hosted Postgres: append `?sslmode=verify-full`.
MDB_DATABASE_URL=postgres://aapi:<MDB_PASSWORD>@127.0.0.1:15433/moderation
